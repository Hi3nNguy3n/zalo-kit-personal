{
  "name": "n8n-nodes-zalo-personal",
  "version": "0.1.0",
  "description": "8 node Zalo cá nhân cho n8n (Login, Message Trigger, Friend Trigger, Send Message, Group, User, Poll, Tag). Đăng nhập & lắng nghe trực tiếp trong n8n (zca-js), session lưu theo credential - hỗ trợ nhiều tài khoản Zalo song song.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZaloApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZaloLogin/ZaloLogin.node.js",
      "dist/nodes/ZaloTrigger/ZaloTrigger.node.js",
      "dist/nodes/ZaloFriendTrigger/ZaloFriendTrigger.node.js",
      "dist/nodes/ZaloSendMessage/ZaloSendMessage.node.js",
      "dist/nodes/ZaloGroup/ZaloGroup.node.js",
      "dist/nodes/ZaloUser/ZaloUser.node.js",
      "dist/nodes/ZaloPoll/ZaloPoll.node.js",
      "dist/nodes/ZaloTag/ZaloTag.node.js"
    ]
  },
  "dependencies": {
    "zca-js": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.4.5"
  }
}
